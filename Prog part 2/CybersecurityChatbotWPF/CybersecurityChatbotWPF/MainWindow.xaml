<Window x:Class="CybersecurityChatbotWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔐 Cybersecurity Awareness Bot - Protecting South African Citizens"
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}">
    
    <Window.Resources>
        <Style x:Key="QuickTopicButton" TargetType="Button">
    <Setter Property="Background" Value="#4A90E2"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Padding" Value="10,5"/>
    <Setter Property="Margin" Value="3"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="BorderRadius" Value="15"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" 
                        CornerRadius="15" 
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>
        <!-- Sentiment to Color Converter -->
        <local:SentimentToColorConverter x:Key="SentimentToColorConverter"/>
        
        <!-- Styles -->
        <Style x:Key="ChatBubbleStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="12,8,12,8"/>
            <Setter Property="Margin" Value="10,5,10,5"/>
            <Setter Property="MaxWidth" Value="400"/>
        </Style>
        
        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header with ASCII Art and Title -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryColor}" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- ASCII Art Logo (simplified for WPF) -->
                <TextBlock Grid.Column="0" 
                           FontFamily="Consolas" 
                           FontSize="8" 
                           Foreground="#4A90E2"
                           Text="╔══════════════════════╗&#x0A;║  ██████╗██╗   ██╗██████╗ ║&#x0A;║ ██╔════╝╚██╗ ██╔╝██╔══██╗║&#x0A;║ ██║      ╚████╔╝ ██████╔╝║&#x0A;║ ██║       ╚██╔╝  ██╔══██╗║&#x0A;║ ╚██████╗   ██║   ██████╔╝║&#x0A;║  ╚═════╝   ╚═╝   ╚═════╝ ║&#x0A;╚══════════════════════╝"
                           TextWrapping="Wrap"/>
                
                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock Text="🔐 CYBERSECURITY AWARENESS BOT" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                    <TextBlock Text="Protecting South African citizens online" 
                               FontSize="11" 
                               Foreground="#B0D4FF"/>
                </StackPanel>
                
                <!-- Status Indicator -->
                <Border Grid.Column="2" 
                        CornerRadius="15" 
                        Background="#27AE60" 
                        Padding="10,5">
                    <TextBlock x:Name="StatusText" 
                               Text="🟢 Active" 
                               Foreground="White" 
                               FontSize="11"/>
                </Border>
            </Grid>
        </Border>
        
        <!-- Main Chat Area -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            
            <!-- Chat Messages Area -->
            <Border Grid.Column="0" 
                    Background="White" 
                    CornerRadius="10" 
                    BorderBrush="#E0E0E0" 
                    BorderThickness="1">
                <DockPanel>
                    <!-- Chat Header -->
                    <Border DockPanel.Dock="Top" 
                            Background="#F0F0F0" 
                            Padding="10" 
                            BorderBrush="#E0E0E0" 
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="💬 Conversation" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"/>
                    </Border>
                    
                    <!-- Messages List -->
                    <ScrollViewer x:Name="MessagesScrollViewer" DockPanel.Dock="Top">
                        <ItemsControl x:Name="MessagesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ChatBubbleStyle}"
                                            HorizontalAlignment="{Binding IsUser, Converter={StaticResource BoolToHorizontalAlignment}}"
                                            Background="{Binding IsUser, Converter={StaticResource UserToBotBackground}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Sender}" 
                                                       FontSize="10" 
                                                       Foreground="Gray"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Message}" 
                                                       FontSize="13" 
                                                       TextWrapping="Wrap"
                                                       Foreground="{Binding Sentiment, Converter={StaticResource SentimentToColorConverter}}"/>
                                            <TextBlock Text="{Binding Timestamp}" 
                                                       FontSize="9" 
                                                       Foreground="Gray"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            
            <!-- Sidebar -->
            <Border Grid.Column="1" 
                    Margin="10,0,0,0" 
                    Background="White" 
                    CornerRadius="10" 
                    BorderBrush="#E0E0E0" 
                    BorderThickness="1">
                <StackPanel Margin="15">
                    <!-- User Info Section -->
                    <Border Background="{StaticResource PrimaryColor}" 
                            CornerRadius="8" 
                            Padding="10" 
                            Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="👤 User Profile" 
                                       Foreground="White" 
                                       FontWeight="Bold" 
                                       FontSize="12"/>
                            <TextBlock x:Name="UserNameText" 
                                       Text="Not logged in" 
                                       Foreground="#B0D4FF" 
                                       FontSize="11"/>
                            <TextBlock x:Name="UserInterestText" 
                                       Text="No interests yet" 
                                       Foreground="#B0D4FF" 
                                       FontSize="10"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Sentiment Indicator -->
                    <Border Background="#FFF3E0" 
                            CornerRadius="8" 
                            Padding="10" 
                            Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="😊 Sentiment Analysis" 
                                       FontWeight="Bold" 
                                       FontSize="12"/>
                            <TextBlock x:Name="SentimentText" 
                                       Text="Neutral" 
                                       FontSize="11" 
                                       Foreground="#E67E22"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Quick Topics -->
                    <TextBlock Text="📚 Quick Topics" 
                               FontWeight="Bold" 
                               FontSize="12" 
                               Margin="0,0,0,10"/>
                    
                    <WrapPanel>
                        <Button Content="🔐 Passwords" 
                                Click="QuickTopic_Click" 
                                Style="{StaticResource QuickTopicButton}"/>
                        <Button Content="🎣 Phishing" 
                                Click="QuickTopic_Click" 
                                Style="{StaticResource QuickTopicButton}"/>
                        <Button Content="🌐 Safe Browsing" 
                                Click="QuickTopic_Click" 
                                Style="{StaticResource QuickTopicButton}"/>
                        <Button Content="👤 Privacy" 
                                Click="QuickTopic_Click" 
                                Style="{StaticResource QuickTopicButton}"/>
                        <Button Content="⚠️ Scams" 
                                Click="QuickTopic_Click" 
                                Style="{StaticResource QuickTopicButton}"/>
                        <Button Content="❓ Help" 
                                Click="QuickTopic_Click" 
                                Style="{StaticResource QuickTopicButton}"/>
                    </WrapPanel>
                    
                    <!-- Memory Section -->
                    <Border Background="#E8F5E9" 
                            CornerRadius="8" 
                            Padding="10" 
                            Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="🧠 What I Remember" 
                                       FontWeight="Bold" 
                                       FontSize="11"/>
                            <TextBlock x:Name="MemoryText" 
                                       Text="No memory items yet" 
                                       FontSize="10" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Input Area -->
        <Border Grid.Row="2" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="0,1,0,0" 
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox x:Name="MessageInput" 
                         Grid.Column="0"
                         Height="40" 
                         VerticalContentAlignment="Center"
                         FontSize="13"
                         TextWrapping="Wrap"
                         KeyDown="MessageInput_KeyDown">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                
                <Button x:Name="SendButton" 
                        Grid.Column="1"
                        Content="📤 Send" 
                        Width="80" 
                        Height="40"
                        Margin="10,0,0,0"
                        Click="SendButton_Click"
                        Background="{StaticResource SecondaryColor}"
                        Foreground="White"
                        FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>
                
                <Button Grid.Column="2"
                        Content="🗑️ Clear" 
                        Width="70" 
                        Height="40"
                        Margin="5,0,0,0"
                        Click="ClearButton_Click"
                        Background="#E74C3C"
                        Foreground="White"
                        FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>