<Application x:Class="CybersecurityChatbotWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="PrimaryColor" Color="#1E3A5F"/>
            <SolidColorBrush x:Key="SecondaryColor" Color="#4A90E2"/>
            <SolidColorBrush x:Key="SuccessColor" Color="#27AE60"/>
            <SolidColorBrush x:Key="WarningColor" Color="#E67E22"/>
            <SolidColorBrush x:Key="DangerColor" Color="#E74C3C"/>
            <SolidColorBrush x:Key="BackgroundColor" Color="#F5F7FA"/>
            <SolidColorBrush x:Key="BotBubbleColor" Color="#E3F2FD"/>
            <SolidColorBrush x:Key="UserBubbleColor" Color="#4A90E2"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>  